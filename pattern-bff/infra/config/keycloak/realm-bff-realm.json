{
  "realm": "realm-bff",
  "enabled": true,
  "registrationEmailAsUsername": true,

  "roles": {
    "realm": [
      {
        "name": "role_admin"
      },
      {
        "name": "role_user"
      }
    ]
  },

  "groups": [
    {
      "name": "admin",
      "path": "/admin",
      "realmRoles": [
        "role_admin",
        "role_user"
      ]
    },
    {
      "name": "user",
      "path": "/user",
      "realmRoles": [
        "role_user"
      ]
    }
  ],

  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@develop.local",
      "emailVerified": true,

      "firstName": "John",
      "lastName" : "Doe",

      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "groups": [ "/admin" ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@develop.local",
      "emailVerified": true,

      "firstName": "Jane",
      "lastName" : "Smith",

      "credentials": [
        { "type": "password", "value": "user", "temporary": false }
      ],
      "groups": [ "/user" ]
    }
  ],

  "clients": [
    {
      "clientId": "client-service-gateway",
      "name": "client-service-gateway",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SERVICE_GATEWAY_KC_OAUTH2_CLIENT_SECRET}",

      "standardFlowEnabled": true,

      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,

      "rootUrl": "https://develop.local",
      "baseUrl": "/",

      "redirectUris": [
        "https://develop.local/login/oauth2/code/*"
      ],

      "webOrigins": [
        "https://develop.local"
      ],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://develop.local/*"
      },

      "fullScopeAllowed": false
    }
  ],

  "scopeMappings": [
    {
      "client": "client-service-gateway",
      "roles": [
        "role_admin",
        "role_user"
      ]
    }
  ],

  "identityProviders": [
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "config": {
        "clientId": "${KC_IDP_GITHUB_CLIENT_ID}",
        "clientSecret": "${KC_IDP_GITHUB_CLIENT_SECRET}",
        "githubJsonFormat": "false"
      }
    }
  ],

  "identityProviderMappers": [
    {
      "name": "github-default-role",
      "identityProviderAlias": "github",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "role": "role_user"
      }
    }
  ]
}